#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit lastpipe

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/betteropts.sh"

summary "Variable name override sample"

option output -o --output PATH \
    var=build_dir \
    help="Output directory"

flag quiet --quiet \
    var=is_quiet \
    help="Suppress output"

argument source required \
    var=input_dir \
    help="Source directory"

betteropts_parse "$@"

echo "build_dir=$build_dir"
echo "quiet=$is_quiet"
echo "input_dir=$input_dir"
