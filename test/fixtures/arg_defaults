#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit lastpipe

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/betteropts.sh"

summary "Argument default sample"

argument commit optional \
    default=HEAD \
    help="Commit ref"

argument reviewers variadic \
    default=alice,bob \
    help="Reviewers"

betteropts_parse "$@"

echo "commit=$commit"
echo "reviewers=${reviewers[*]:-}"
